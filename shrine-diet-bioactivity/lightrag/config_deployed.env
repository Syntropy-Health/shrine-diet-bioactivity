# LightRAG — DEPLOYED profile (kg-mcp on Railway). Selected by the image
# (Dockerfile SHRINE_CONFIG=deployed). #104, [PRINCIPAL-RULED 2026-10-03]:
# embed queries with the SAME embedder the Aura vectors were built with,
# gemini-embedding-001 @ 1024 on Vertex, and read those vectors from Aura.
#
# Precedence: scoped_server loads this file with override=True, so values set
# here WIN over the Railway service env. GCP project/location and the service
# account are therefore deliberately NOT set here — they come from Railway:
#   GOOGLE_APPLICATION_CREDENTIALS_JSON  (written to a 0600 file at boot by
#                                         scripts/write_adc.sh)
#   GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION
# No credential literal may ever be added to this file.
#
# Server
HOST=0.0.0.0
PORT=9621
# LLM — answer synthesis for kg_query: Gemini on Vertex [PRINCIPAL-RULED 2026-10-12,
# relayed via #14290; CTO #14291]. Same project + service account as the embedder.
#   Model: gemini-3.5-flash-lite. Price $0.30 / $2.50 per 1M input / output tokens,
#   standard tier — INFERRED from aggregators (Requesty, llmgateway, benchlm), NOT yet
#   read off the official Vertex pricing page.
#   Why not gemini-2.5-flash: it retires 2026-10-20 per the Vertex model docs, while a
#   Vertex release note says 2026-10-16 — the sources disagree; both are within days.
# LLM_VERTEX_LOCATION is deliberately SEPARATE from GOOGLE_CLOUD_LOCATION (the
# embedder's, us-central1 from Railway): the 3.x models are served from `global` only
# (MEASURED 2026-10-12: 404 NOT_FOUND in us-central1), and moving the embedder would
# leave the Aura vectors' region. Do not merge the two keys (test-pinned).
# Fallback: LLM_BINDING=none serves retrieval-only answers (answer_mode=retrieval_only),
# which /health reports as llm=disabled and the deploy gate grades RED.
# Previous binding (OpenRouter nemotron :free) was withdrawn upstream -> 404 (#14271).
LLM_BINDING=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_VERTEX_LOCATION=global
# Embedding — Vertex AI Gemini, matching WorkspaceMeta on unified_diet_kg.
# scoped_server checks these at boot, BEFORE opening the Aura vector index. If the
# workspace's stamped space differs, WorkspaceMeta is absent, the project or the
# credential is missing, or the vector index fails to open, semantic /query returns
# 503 with the reason (also on /health as semantic=disabled); typed routes stay up.
EMBEDDING_BINDING=vertex
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT=120
# Vertex default quota returns 429 above 1 concurrent embed (measured 2026-09-11).
EMBEDDING_FUNC_MAX_ASYNC=1
EMBEDDING_BATCH_NUM=8
# Never let the gateway drop + recreate a vector index (an ingest-only opt-in in
# scoped_neo4j_vector_storage.py). Empty overrides any inherited =1 (override=True).
VECTOR_INDEX_ALLOW_RECREATE=
# Storage — graph AND vectors on Aura (ADR 0001).
KG_VECTOR_BACKEND=neo4j
LIGHTRAG_GRAPH_STORAGE=ScopedNeo4JStorage
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_VECTOR_STORAGE=ScopedNeo4JVectorStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
WORKING_DIR=./rag_storage_local
# Neo4j — Aura (values injected from the Railway env; no literals)
NEO4J_URI=${NEO4J_URI}
NEO4J_USERNAME=${NEO4J_USERNAME}
NEO4J_PASSWORD=${NEO4J_PASSWORD}
NEO4J_DATABASE=${NEO4J_DATABASE:-neo4j}
# Workspace
WORKSPACE=unified_diet_kg
SUMMARY_LANGUAGE=English
# Concurrency
MAX_ASYNC=4
MAX_PARALLEL_INSERT=2
# Reranking — disabled
RERANK_BINDING=null
# Query defaults (same as config_local.env)
TOP_K=40
CHUNK_TOP_K=20
MAX_TOTAL_TOKENS=30000
ENABLE_LLM_CACHE=true
ENABLE_LLM_CACHE_FOR_EXTRACT=true
